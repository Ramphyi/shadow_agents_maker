# Copy to .env. Everything here is optional; providers and secrets can also be set in the app.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# SHADOW_OLLAMA_URL=http://host.docker.internal:11434
# SHADOW_OLLAMA_MODEL=gpt-oss:20b
# SHADOW_PORT=7777
# TZ=Europe/Bucharest
# On Linux, set these to your user so the data folder stays yours:  id -u / id -g
# SHADOW_UID=1000
# SHADOW_GID=1000
