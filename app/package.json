    "start": "vite build && node electron/launch.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "animejs": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
