{
  "name": "@shadow/app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5273 && cross-env SHADOW_DEV=1 node electron/launch.cjs\"",
